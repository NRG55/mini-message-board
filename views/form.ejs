<html>
<head>    
    <title>Create New Message</title>
</head>
<body>
    <main>
        <h1>New Message</h1>
         <%- include("partials/errors.ejs") %>
        <form method="POST" action="/new">
            <div>
                <label for="userName">Name</label>
                <input 
                    type="text" 
                    name="userName" 
                    id="userNmame" 
                    required
                />
            </div>
            <div>
                <label for="message">Message</label>
                <textarea 
                    name="message" 
                    id="message"
                    cols="20"
                    rows="4"                    
                ></textarea>
            </div>
            <button type="submit">Submit</button>
        </form>
    </main>    
</body>
</html>